# Provide either ASTPP_TOKEN_KEY_HEX or ASTPP_TOKEN_KEY.
# Provide one of ASTPP_IV_HEX, ASTPP_IV_DERIVED, or ASTPP_IV_KEY.
# Provide either ASTPP_SSH_PRIVATE_KEY or ASTPP_SSH_PRIVATE_KEY_PATH.

# Additional required settings reported missing by startup validation.
# Set these in the deployed environment; production CORS origins must be exact HTTPS origins.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=
