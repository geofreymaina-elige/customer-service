# Customer Management Service Configuration
PORT=5005
NODE_ENV=development

# PostgreSQL Configuration (Customer Management DB)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ambia_pay
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# JWT & Security Configuration
# Must be at least 32 characters in production
JWT_SECRET=super_secret_production_ready_jwt_key_customer_management_2026_min_32_chars
JWT_EXPIRATION_SECONDS=900
DEVICE_UUID_SALT=AMBIA_DEVICE_SALT_SECURE_2026_X99
OTP_SALT=AMBIA_OTP_SALT_SECURE_2026_V1

# ASTPP VoIP MySQL Integration
ASTPP_HOST=localhost
ASTPP_PORT=3306
ASTPP_DATABASE=astpp
ASTPP_USER=root
ASTPP_PASSWORD=

# Kafka CDC Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ambia-pay-cdc-consumer
KAFKA_GROUP_ID=ambia-pay-customer-sync
KAFKA_TOPIC_ACCOUNTS=mysql.astpp.accounts
KAFKA_TOPIC_APPLICATIONS=mysql.astpp.applications
KAFKA_TOPIC_APPLICANT_DETAILS=mysql.astpp.applicant_details
KAFKA_TOPIC_DIDS=mysql.astpp.dids

# SasaPay WaaS & KYC Onboarding Integration
SASAPAY_ENABLED=true
SASAPAY_ENVIRONMENT=sandbox
SASAPAY_CLIENT_ID=your_sasapay_client_id
SASAPAY_CLIENT_SECRET=your_sasapay_client_secret
SASAPAY_MERCHANT_CODE=your_sasapay_merchant_code
SASAPAY_BASE_URL=https://sandbox.sasapay.app
SASAPAY_CALLBACK_URL=https://api.yourdomain.com/api/v1/callbacks/sasapay/onboarding

# Notification / SMS Service Configuration
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_API_KEY=


