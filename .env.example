# Document Type Fix Script Configuration
# Copy this file to .env and fill in your actual values

# ASTPP MySQL (READ-ONLY - script will never modify this database)
ASTPP_MYSQL_HOST=localhost
ASTPP_MYSQL_PORT=3306
ASTPP_MYSQL_USER=astpp
ASTPP_MYSQL_PASSWORD=your_astpp_password_here
ASTPP_MYSQL_DATABASE=astpp

# PostgreSQL (READ-WRITE - script will fix mismatches here)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DATABASE=customer_service

# Optional: Batch size for processing (default: 100)
FIX_BATCH_SIZE=100
