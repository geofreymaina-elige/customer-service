{
  "info": {
    "_postman_id": "cc4c66a2-8f8f-467b-b8c3-43de4d237d1f",
    "name": "Patroni REST API",
    "description": "Full Patroni REST API surface (v4.1.0) — health/status, cluster info, role-based queries, dynamic config, and cluster actions (reload/restart/reinitialize/switchover/failover).\n\nNode-specific requests (health, reload, restart, reinitialize, and role checks such as /primary and /replica) use per-node variables ({{node1_url}}, {{node2_url}}, {{node3_url}}). Role checks are node-local: call each member URL to identify which node currently returns 200 for /primary.\n\nCluster information and configuration requests default to node1; use another reachable member if node1 is down. These are Patroni HTTP URLs, not PostgreSQL connection endpoints. See docs/postgres-patroni-primary-routing.md for application routing, cache, and failover trade-offs.\n\nUse the Patroni - Staging or Patroni — Production environment as appropriate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "38371113"
  },
  "item": [
    {
      "name": "Node 1 — Health & Local Actions",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node1_url}}/health",
              "host": [
                "{{node1_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns 200 if Patroni is responsive on this node."
          },
          "response": []
        },
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node1_url}}/liveness",
              "host": [
                "{{node1_url}}"
              ],
              "path": [
                "liveness"
              ]
            },
            "description": "Kubernetes-style liveness probe. 200 if the Patroni process is alive."
          },
          "response": []
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node1_url}}/readiness",
              "host": [
                "{{node1_url}}"
              ],
              "path": [
                "readiness"
              ]
            },
            "description": "200 only if this node is a running primary or a streaming replica ready to serve traffic."
          },
          "response": []
        },
        {
          "name": "Patroni Status (this node)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node1_url}}/patroni",
              "host": [
                "{{node1_url}}"
              ],
              "path": [
                "patroni"
              ]
            },
            "description": "Detailed local status: role, state, timeline, xlog position, Patroni version."
          },
          "response": []
        },
        {
          "name": "Reload Patroni Config (SIGHUP)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{node1_url}}/reload",
              "host": [
                "{{node1_url}}"
              ],
              "path": [
                "reload"
              ]
            },
            "description": "Tells Patroni to re-read patroni.yml on this node. NOTE: this reloads Patroni's own config, not PostgreSQL's pg_hba.conf — use SELECT pg_reload_conf() or pg_ctl reload against Postgres directly for that."
          },
          "response": []
        },
        {
          "name": "Restart PostgreSQL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restart_pending\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{node1_url}}/restart",
              "host": [
                "{{node1_url}}"
              ],
              "path": [
                "restart"
              ]
            },
            "description": "Restarts PostgreSQL on this node. Optional body can constrain the restart (e.g. only if a restart is pending, or within a timeframe/schedule) — see Patroni docs for full body options (schedule, role, postgres_version)."
          },
          "response": []
        },
        {
          "name": "Reinitialize Replica",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"force\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{node1_url}}/reinitialize",
              "host": [
                "{{node1_url}}"
              ],
              "path": [
                "reinitialize"
              ]
            },
            "description": "Wipes this node's local data directory and re-clones it from the current leader via pg_basebackup. Only valid on a replica — will error if run against the current leader. \"force\": true skips the check for an in-progress operation."
          },
          "response": []
        }
      ]
    },
